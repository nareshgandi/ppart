CREATE SCHEMA partman;
CREATE EXTENSION pg_partman SCHEMA partman;

CREATE TABLE orders_range (
    id BIGINT NOT NULL,
    order_date TIMESTAMP NOT NULL,
    customer_id INT NOT NULL,
